# =============================================================================
# smol.env  --  local configuration for rendering the Smolfile
# =============================================================================
# Copy this file to `smol.env` and adjust the values to your machine.
# `smol.env` is gitignored so your personal paths never end up on GitHub.
#
#   cp smol.env.example smol.env
#   ./render-smolfile.sh
# =============================================================================

# Base container image.
SMOL_IMAGE="alpine:latest"

# Host directory that holds your projects (mounted at /projects).
PROJECTS_DIR="$HOME/projects"

# Host directory with your pi agent config (mounted at /root/.pi/agent/).
PI_AGENT_DIR="$HOME/.pi/agent/"

# Host directory with your shared agents/skills (mounted at /root/.agents/).
AGENTS_DIR="$HOME/.agents/"
